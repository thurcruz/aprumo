# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Reserved for server-only integrations (WhatsApp/administration).
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public application URL used by authentication callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only OpenAI Responses API configuration.
OPENAI_API_KEY=sk-your-server-key
OPENAI_MODEL=gpt-5.6-luna

# Resend (server-only). Para o remetente branded dos e-mails de auth, esta chave vai
# no painel do Supabase (Authentication > SMTP Settings) como senha do SMTP — o app NÃO
# a lê. Preencha aqui apenas se for enviar e-mail direto do app/edge functions.
RESEND_API_KEY=re_your_server_key

# Stripe (assinatura Aprumo+). Chaves de teste (sk_test_/whsec_...) enquanto
# não for para produção. STRIPE_WEBHOOK_SECRET vem de `stripe listen` em
# desenvolvimento, ou do painel (Developers > Webhooks) em produção.
STRIPE_SECRET_KEY=sk_test_sua_chave
STRIPE_WEBHOOK_SECRET=whsec_seu_segredo

# IDs dos Preços criados no Stripe (Products > Prices). Mensal e anual são
# recorrentes; o pacote extra é pagamento avulso (one-time).
STRIPE_PRICE_MONTHLY=price_mensal
STRIPE_PRICE_ANNUAL=price_anual
STRIPE_PRICE_TOPUP=price_pacote_extra

# Quantos créditos cada Preço concede — 1 crédito = 1 mensagem da Pri.
# price_id:créditos, separados por vírgula. Os três IDs acima devem aparecer aqui.
STRIPE_PRICE_CREDITS=price_mensal:300,price_anual:3600,price_pacote_extra:100

# Só para exibir o valor em Configurações antes de a pessoa entrar no checkout
# (o valor cobrado de verdade é sempre o do Preço no Stripe). Em centavos.
NEXT_PUBLIC_PRICE_MONTHLY_CENTS=2490
NEXT_PUBLIC_PRICE_ANNUAL_CENTS=14990

# Pri no WhatsApp (Meta Cloud API, direto — sem BSP). Criados em
# developers.facebook.com > seu app > WhatsApp > Configuração da API.
# WHATSAPP_VERIFY_TOKEN é uma string à sua escolha, digitada também no painel
# ao cadastrar a URL do webhook (https://SEU_DOMINIO/api/webhooks/whatsapp).
WHATSAPP_ACCESS_TOKEN=seu_token_de_acesso_permanente
WHATSAPP_PHONE_NUMBER_ID=id_do_numero_de_telefone
WHATSAPP_APP_SECRET=segredo_do_app_meta
WHATSAPP_VERIFY_TOKEN=uma-string-qualquer-que-so-voce-sabe
# Versão da Graph API — atualize se a Meta depreciar esta.
WHATSAPP_GRAPH_VERSION=v23.0
# Só para mostrar em Configurações o número que a pessoa deve chamar (formato livre, ex.: "+55 11 5028-1300").
NEXT_PUBLIC_WHATSAPP_NUMBER=
